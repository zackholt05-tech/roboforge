# Copy to .env (gitignored) and adjust. Never put real secrets in committed files.

# Where datasets live. Defaults to <repo>/data when unset.
ROBOFORGE_DATA_ROOT=

# MuJoCo OpenGL backend: cgl (macOS), egl (Linux + NVIDIA GPU), osmesa (Linux CPU).
# Leave empty to use the platform default chosen by roboforge.sim.backend.
MUJOCO_GL=

# Modal credentials are managed by `modal token new` (stored in ~/.modal.toml, outside
# the repo). Do NOT copy Modal tokens here. Remote jobs require explicit owner approval.
